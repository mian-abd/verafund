# Database: Turso (libSQL) in the cloud, or a local SQLite file.
# Local dev defaults to file:verafund.db when DATABASE_URL is unset.
DATABASE_URL=libsql://your-db-name-your-org.turso.io
DATABASE_AUTH_TOKEN=

# Stripe Issuing sandbox. Leave empty to run in Simulated mode (no payment network).
# Only test-mode keys (sk_test_...) are accepted.
STRIPE_SECRET_KEY=
# Optional: reuse an existing sandbox cardholder; otherwise one is created on first use.
STRIPE_CARDHOLDER_ID=
